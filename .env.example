# ── Web / SSO ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Comma-separated emails allowed into the app (SSO alone is not enough)
ALLOWED_USERS=dave@tagsolutions.com,kai@tagsolutions.com
# "False" bypasses SSO for local dev only
REQUIRE_AUTH=True

# ── LLM ────────────────────────────────────────────────────────────────────
HATZAI_API_KEY=
HATZAI_MODEL=anthropic.claude-sonnet-4-6
# Fast model for quick high-volume judgments (junk triage)
HATZAI_FAST_MODEL=anthropic.claude-haiku-4-5

# ── Database (same orchestration vars as tag-tool-suite) ───────────────────
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=
DB_POSTGRESDB_USER=
DB_POSTGRESDB_PASSWORD=
DATABASE_URL=

# ── Connectors (filled in during Phase 0 probes) ───────────────────────────
# Microsoft Graph. "delegated" = Dave signed in once via scripts/connect_microsoft.py
# (no secret needed); "app" = admin-granted app-only access (needs GRAPH_CLIENT_SECRET)
GRAPH_AUTH_MODE=delegated
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
MSAL_CACHE_PATH=.secrets/msal_token_cache.json
# Dave's local timezone (IANA name)
ASSISTANT_TIMEZONE=America/New_York
AUTOTASK_USERNAME=
AUTOTASK_SECRET=
AUTOTASK_INTEGRATION_CODE=
HUBSPOT_PRIVATE_APP_TOKEN=
AUTOTASK_ZONE_URL=
AUTOTASK_DAVE_RESOURCE_ID=
