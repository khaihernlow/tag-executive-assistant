# Geronimo, Dave's assistant. Copy to .env and fill in. Real values live in IT Glue / with Khai,
# never in git. See docs/DEPLOY.md.

# ── Signing in to the app (Microsoft Entra SSO) ─────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Who may use the app (Microsoft sign-in alone is not enough)
ALLOWED_USERS=dvener@tagsolutions.com,klow@tagsolutions.com
# "False" skips sign-in: local development only, never on the server
REQUIRE_AUTH=True

# ── AI (HatzAI) ────────────────────────────────────────────────────────────
HATZAI_API_KEY=
HATZAI_MODEL=anthropic.claude-sonnet-4-6
# Quick, high-volume judgments (junk triage, meeting requests)
HATZAI_FAST_MODEL=anthropic.claude-haiku-4-5

# ── Dave's Microsoft 365 (mail, calendar, Teams) ───────────────────────────
# "delegated": accounts signed in once with scripts/connect_microsoft.py; tokens in MSAL_CACHE_PATH
GRAPH_AUTH_MODE=delegated
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=dvener@tagsolutions.com
# Who signs in to work in Dave's mailbox. Unset = Dave himself. assistant@ = Geronimo, as his delegate
GRAPH_SIGNIN_AS=
# Geronimo's own account: Teams messages (lunch) are sent as Geronimo
ASSISTANT_ACCOUNT=assistant@tagsolutions.com
MSAL_CACHE_PATH=.secrets/msal_token_cache.json
INTERNAL_DOMAIN=tagsolutions.com
ASSISTANT_TIMEZONE=America/New_York

# ── Autotask ───────────────────────────────────────────────────────────────
AUTOTASK_USERNAME=
AUTOTASK_SECRET=
AUTOTASK_INTEGRATION_CODE=
AUTOTASK_ZONE_URL=
AUTOTASK_WEB_URL=https://ww1.autotask.net
AUTOTASK_DAVE_RESOURCE_ID=

# ── Matt's tag_data (PostgreSQL), read-only: contract renewals ─────────────
# Same variables as tag-tool-suite. In Docker, HOST is the Postgres container's name on n8n-network,
# not localhost. Empty HOST = no renewals feature; everything else still works.
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=tag_data
DB_POSTGRESDB_USER=
DB_POSTGRESDB_PASSWORD=

# ── HubSpot (private app token) ────────────────────────────────────────────
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_CLIENT_SECRET=

# ── Azure AI Speech (transcribing recordings), East US ─────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ── Apify (LinkedIn backgrounds for briefs) ────────────────────────────────
APIFY_TOKEN=
APIFY_MONTHLY_BUDGET_USD=4

# ── Wednesday lunch (Mealeo) ───────────────────────────────────────────────
MEALEO_EMAIL=
MEALEO_PASSWORD=
MEALEO_PROFILE=.secrets/mealeo-profile
# Off until Dave says so. Off = a dry run: nobody is messaged; the plan just shows on Today. "true" = live
LUNCH_LIVE=

# ── Storage and the background worker ──────────────────────────────────────
ASSISTANT_DB_PATH=data/assistant.db
RECORDINGS_DIR=data/recordings
# True on exactly ONE running copy: it sweeps the inbox, writes briefs and sends Teams messages
WORKER_ENABLED=True
# Approval kinds that skip the approval card (comma-separated); leave empty
ACTION_AUTO=
